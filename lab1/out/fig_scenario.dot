digraph G {
rankdir=TB; nodesep=0.45; ranksep=0.45; newrank=true;
node [shape=box, style="rounded,filled", fillcolor="#dce8f7", color="#2a78d6", fontname="Arial", fontsize=13, width=2.3, height=0.8];
edge [color="#52514e", fontname="Arial", fontsize=12];
m [label="30 лічильників\nModbus RTU,\nімпульсні входи"];
g [label="Шлюз:\nопитування\nкожні 15 хв"];
c [label="Зв'язок\nє?", shape=diamond, fillcolor="#fff4d6", color="#eda100", width=1.4];
b [label="Буфер до 72 год,\nстатус missing до\nдозавантаження", fillcolor="#fbe1d6", color="#eb6834"];
q [label="MQTT 5, QoS 1,\nконтроль якості\nпоказів"];
s [label="Інтервальне\nспоживання: різниця\nнакопичувальних\nпоказів"];
a [label="Порівняння з базою:\n4 інтервали >\nбаза + max(3σ; 10%)"];
n [label="Сповіщення\nз оцінкою кВт·год\nі EUR на добу"];
i [label="Інцидент:\nтехнік, причина,\nзакриття"];
r [label="Повернення до бази,\nзбережений обсяг,\nмісячний звіт"];
{rank=same; m; g; c;}
{rank=same; s; q; b;}
{rank=same; a; n; i;}
m -> g -> c;
c -> b [label=" ні"];
c -> q [label="так"];
q -> b [dir=back, style=dashed, label="після\nвідновлення"];
s -> q [dir=back];
m -> s [style=invis];
s -> a;
a -> n [label="аномалія"];
n -> i;
i -> r;
}